  "assumptions": {
    "space": "Arbitrary complete real inner-product space.",
    "objectives": "Proper closed convex extended-real f,g; actual proximal maps supplied at positive gamma.",
    "iteration": "z(k+1)=(1-lambda(k))*z(k)+lambda(k)*TPRS(z(k));0<lambda(k)<=1; a fixed point zs is supplied.",
    "regularity": "Positive mu,beta. Either f is mu-strongly convex and g has a smooth convex real representative with beta^-1-Lipschitz gradient, or vice versa.",
    "factor": "sqrt(1-(4*lambda/3)*min(gamma*mu,beta/gamma,1-lambda))",
    "auxiliary_estimate": "Four nonnegative regularity parameters; smooth representatives required only when the corresponding beta is positive. Full exact signatures in targets/ are authoritative."
  },
