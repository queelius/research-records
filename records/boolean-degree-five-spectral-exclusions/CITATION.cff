cff-version: "1.2.0"
message: "Cite this exact archived version 1.5.0 for the conditional residual-six and whole-pattern exclusions with LRAT certificates; the original Boolean existence problem remains open."
type: "dataset"
title: "Exact spectral exclusions, singleton components, graph locality, residual-six lemmas and LRAT-certified residual-six exclusions for degree-five Boolean candidates"
version: "1.5.0"
authors: [{"family-names": "Towell", "given-names": "Alexander Richard", "orcid": "https://orcid.org/0000-0001-6443-9897", "affiliation": "Southern Illinois University Edwardsville"}]
license: ["MIT", "CC-BY-4.0"]
abstract: "Conditionally on AI-reviewed written reductions and earlier premises, every residual-defect at most 6 instance with a negative-free coordinate is excluded, and lemma L1 excludes the whole negative quintic patterns (2,2,2,2) and (2,2,2,2,1), with 6,871 LRAT case certificates replayed by independent readers in a network-less container. Residual six is not closed; 27 of 73 patterns remain open. Substantial AI assistance (OpenAI Codex; Claude Code) is disclosed. No Boolean construction, nonexistence proof, novelty, formal verification or human peer review is established."
repository-code: "https://github.com/queelius/boolean-degree-sensitivity"
keywords: ["Boolean functions", "polynomial degree", "sensitivity", "sparse Fourier analysis", "LRAT certificates", "SAT", "exact verification"]
doi: "10.5281/zenodo.23999933"
url: "https://doi.org/10.5281/zenodo.23999933"
date-released: "2026-11-06"
